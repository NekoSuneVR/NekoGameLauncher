<Window x:Class="NekoGameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neko Game Launcher" Height="860" Width="1420" MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#090D15" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0,6,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="23" Height="23" CornerRadius="7" Background="{StaticResource AccentGradientBrush}" Margin="0,0,9,0"><TextBlock Text="N" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="Neko Game Launcher" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Background="#132033" CornerRadius="5" Padding="7,2" Margin="10,0,0,0"><TextBlock Text="GAMING HUB" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/></Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowButtonStyle}" Content="—" Click="Minimize_Click"/>
                        <Button Style="{StaticResource WindowButtonStyle}" Content="□" Click="Maximize_Click"/>
                        <Button Style="{StaticResource WindowButtonStyle}" Content="✕" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="1">
                <TabItem Header="LIBRARY" Style="{StaticResource NavTabStyle}">
                    <Grid Margin="30,25,30,20">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Your Library" Style="{StaticResource PageTitleStyle}"/>
                                <TextBlock Text="Steam, Epic, Wargaming, HoYoPlay, Kuro, Xbox and standalone PC games in one place." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="SEARCH INSTALLED GAMES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource DimTextBrush}" Margin="2,0,0,6"/><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource HeroGradientBrush}" BorderBrush="#41305F" BorderThickness="1" CornerRadius="16" Margin="0,20,0,17" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="READY TO PLAY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0"><TextBlock Text="{Binding Games.Count}" FontSize="34" FontWeight="Bold"/><TextBlock Text=" games discovered" FontSize="16" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Bottom" Margin="5,0,0,6"/></StackPanel>
                                    <TextBlock Text="Playtime monitoring also works when a detected game is started from its original launcher." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="↻  RESCAN LIBRARY" Command="{Binding RefreshLibraryCommand}" VerticalAlignment="Center" Padding="20,11"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding GamesView}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorderStyle}" Width="320" Height="195" Margin="0,0,14,14">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Width="38" Height="38" CornerRadius="10" Background="#221D3B" BorderBrush="#4D3B7A" BorderThickness="1"><TextBlock Text="◆" Foreground="{StaticResource AccentBrightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                    <StackPanel Grid.Column="1" Margin="11,0,0,0"><TextBlock Text="{Binding Launcher}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/><TextBlock Text="{Binding StatusLabel}" FontSize="9" Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,0"/></StackPanel>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding PlayTimeLabel}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock Text="{Binding SessionLabel}" FontSize="9" Foreground="{StaticResource DimTextBrush}" HorizontalAlignment="Right"/></StackPanel>
                                                </Grid>
                                                <StackPanel Grid.Row="1" Margin="0,12,0,8">
                                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="48"/>
                                                    <TextBlock Text="{Binding InstallPath}" Foreground="{StaticResource DimTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                                    <TextBlock Text="{Binding PerformanceLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,5,0,0"/>
                                                </StackPanel>
                                                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="PLAYTIME TRACKED LOCALLY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource DimTextBrush}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="▶  PLAY" Padding="16,7" Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Grid Grid.Row="3" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" Foreground="{StaticResource DimTextBrush}" FontSize="11"/><TextBlock Grid.Column="1" Text="LOCAL LIBRARY • LOCAL PLAYTIME • NO GAME PASSWORDS READ" Foreground="{StaticResource DimTextBrush}" FontSize="10" FontWeight="SemiBold"/></Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="GAMING HUB" Style="{StaticResource NavTabStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="30,25,30,30">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Gaming Hub" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Live PC performance, active game monitoring, playtime and reversible performance tuning." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel>
                                <Border Grid.Column="1" Background="#102622" BorderBrush="#1F5C4C" BorderThickness="1" CornerRadius="10" Padding="12,7" VerticalAlignment="Center"><TextBlock Text="●  LIVE MONITOR" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="Bold"/></Border>
                            </Grid>

                            <Border Background="{StaticResource HeroGradientBrush}" BorderBrush="#4A3A6C" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,20,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="{Binding GamingModeLabel}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/><TextBlock Text="Performance Mode" FontSize="24" FontWeight="Bold" Margin="0,5,0,2"/><TextBlock Text="{Binding GamingModeDetail}" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="Safe mode: Neko does not terminate background processes. Your previous power plan is restored when disabled." Foreground="{StaticResource DimTextBrush}" FontSize="10" Margin="0,8,0,0"/></StackPanel>
                                    <Button Grid.Column="1" Content="⚡  TOGGLE GAMING MODE" Command="{Binding ToggleGamingModeCommand}" VerticalAlignment="Center" Padding="20,11"/>
                                </Grid>
                            </Border>

                            <UniformGrid Columns="4" Margin="0,0,0,16">
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0" Padding="17"><StackPanel><TextBlock Text="SYSTEM CPU" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/><TextBlock Text="{Binding SystemCpuPercent, StringFormat={}{0:0}%}" FontSize="29" FontWeight="Bold" Margin="0,8,0,0"/><ProgressBar Value="{Binding SystemCpuPercent}" Maximum="100" Height="5" Margin="0,10,0,0"/></StackPanel></Border>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0" Padding="17"><StackPanel><TextBlock Text="SYSTEM MEMORY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrightBrush}"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="{Binding MemoryUsedGb, StringFormat={}{0:0.0}}" FontSize="29" FontWeight="Bold"/><TextBlock Text=" GB" FontSize="13" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Bottom" Margin="2,0,0,5"/></StackPanel><ProgressBar Value="{Binding MemoryPercent}" Maximum="100" Height="5" Margin="0,10,0,0"/></StackPanel></Border>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0" Padding="17"><StackPanel><TextBlock Text="ACTIVE GAME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="{Binding ActiveGameName}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding ActiveGameSession}" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel></Border>
                                <Border Style="{StaticResource CardBorderStyle}" Padding="17"><StackPanel><TextBlock Text="GAME LOAD" FontSize="10" FontWeight="Bold" Foreground="#FFB86C"/><TextBlock Text="{Binding ActiveGameCpuPercent, StringFormat=CPU {0:0}%}" FontSize="17" FontWeight="Bold" Margin="0,9,0,0"/><TextBlock Text="{Binding ActiveGameMemoryMb, StringFormat=RAM {0:0} MB}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                            </UniformGrid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0" Padding="18">
                                    <StackPanel><TextBlock Text="MOST PLAYED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/><ItemsControl ItemsSource="{Binding TopPlayedGames}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#0E1623" BorderBrush="#26344C" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Launcher}" FontSize="10" Foreground="{StaticResource DimTextBrush}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding PlayTimeLabel}" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock Text="{Binding LaunchCount, StringFormat={}{0} sessions}" FontSize="9" Foreground="{StaticResource DimTextBrush}" HorizontalAlignment="Right"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0" Padding="18">
                                    <StackPanel><TextBlock Text="WINDOWS GAMING TOOLS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrightBrush}"/><TextBlock Text="Quick controls" FontSize="19" FontWeight="Bold" Margin="0,6,0,10"/><Button Content="WINDOWS GAME MODE" Command="{Binding OpenWindowsGameModeCommand}" HorizontalAlignment="Stretch"/><Button Content="GRAPHICS SETTINGS" Command="{Binding OpenGraphicsSettingsCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch"/><Button Content="TASK MANAGER" Command="{Binding OpenTaskManagerCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch"/><TextBlock Text="More planned: GPU telemetry, FPS/frametime integration, per-game profiles and thermal alerts." Foreground="{StaticResource DimTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="DEALS &amp; FREE GAMES" Style="{StaticResource NavTabStyle}">
                    <Grid Margin="30,25,30,20">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Deals &amp; Free Games" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Giveaways and discounted PC games from your configured feeds." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel>
                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="13" Padding="12" Margin="0,20,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding DealsQuery, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/><Button Grid.Column="1" Content="REFRESH OFFERS" Command="{Binding RefreshDealsCommand}"/><Button Grid.Column="2" Content="LOOK UP GAME" Command="{Binding LookupGamesCommand}" Style="{StaticResource SecondaryButtonStyle}"/><CheckBox Grid.Column="3" Content="Free only" IsChecked="{Binding FreeOnly}" VerticalAlignment="Center" Margin="14,0,8,0"/></Grid></Border>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="FEATURED OFFERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" Margin="7,3,0,10"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Deals}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#0E1623" BorderBrush="#26344C" BorderThickness="1" CornerRadius="11" Padding="12" Margin="4,4,4,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="78" Height="58" Background="#090E16" CornerRadius="8"><Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="11,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Source}" Foreground="{StaticResource CyanBrush}" FontSize="10"/><TextBlock Text="{Binding PriceLabel}" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="2" Content="VIEW" Command="{Binding DataContext.OpenDealCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border>
                            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="GAME LOOKUP" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrightBrush}" Margin="7,3,0,10"/><ScrollViewer Grid.Row="1"><ItemsControl ItemsSource="{Binding OnlineGames}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#0E1623" BorderBrush="#26344C" BorderThickness="1" CornerRadius="10" Padding="12" Margin="4,4,4,9"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding CheapestPrice, StringFormat=Best known price: {0}}" Foreground="{StaticResource SuccessBrush}" Margin="0,5,0,8"/><Button Content="OPEN DEAL" Command="{Binding DataContext.OpenLookupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Left"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="LAUNCHERS" Style="{StaticResource NavTabStyle}">
                    <Grid Margin="30,25,30,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Connected Launchers" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Launcher detection now includes Wargaming.net, HoYoPlay and Kuro alongside the original networks." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel>
                        <Border Grid.Row="1" Background="#17152B" BorderBrush="#403761" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,20,0,14"><TextBlock Text="DISCOVERY  •  Known standalone installs are also found from Windows uninstall metadata and common game folders, including Wuthering Waves, ZZZ, NTE, Infinity Nikki, Star Citizen, Tarkov, Warframe, FFXIV and more." Foreground="#C7BDF6" TextWrapping="Wrap"/></Border>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Launchers}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CardBorderStyle}" Padding="17" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="230"/><ColumnDefinition Width="140"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="11" Background="#211D37" BorderBrush="#463A69" BorderThickness="1"><TextBlock Text="◆" Foreground="{StaticResource AccentBrightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBlock Grid.Column="2" Text="{Binding StatusLabel}" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding GameCount, StringFormat={}{0} games}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding ExecutablePath}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource DimTextBrush}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="SETTINGS" Style="{StaticResource NavTabStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,25,30,30" MaxWidth="980" HorizontalAlignment="Left">
                        <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Control automatic performance behaviour and your deal feeds." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,20"/>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="20" Margin="0,0,0,16"><StackPanel><TextBlock Text="GAMING MODE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/><TextBlock Text="Performance automation" Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,10"/><CheckBox Content="Automatically enable Gaming Mode while a detected game is running" IsChecked="{Binding AutoGamingMode}"/><CheckBox Content="Boost detected game processes to Above Normal priority while Gaming Mode is active" IsChecked="{Binding BoostGamePriority}"/><TextBlock Text="Gaming Mode never blindly closes background apps. It changes the power plan and process priority only, then restores them." Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap" Margin="6,6,0,8"/><Button Content="SAVE SETTINGS" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="20" Margin="0,0,0,16"><StackPanel><TextBlock Text="DEAL PROVIDERS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrightBrush}"/><CheckBox Content="GamerPower free games and giveaways" IsChecked="{Binding UseGamerPower}"/><CheckBox Content="CheapShark PC game deals and price lookup" IsChecked="{Binding UseCheapShark}"/></StackPanel></Border>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="20"><StackPanel><TextBlock Text="CUSTOM DEAL ENDPOINT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrightBrush}"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding NewEndpointName}" Margin="0,0,8,0"/><TextBox Grid.Column="1" Text="{Binding NewEndpointUrl}" Margin="0,0,8,0"/><Button Grid.Column="2" Content="ADD ENDPOINT" Command="{Binding AddEndpointCommand}"/></Grid><ItemsControl ItemsSource="{Binding CustomEndpoints}" Margin="0,14,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#0E1623" BorderBrush="#26344C" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Url}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}"/><Button Grid.Column="2" Content="REMOVE" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.RemoveEndpointCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
