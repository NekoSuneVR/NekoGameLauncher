<Window x:Class="NekoGameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neko Game Launcher" Height="820" Width="1320" MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="390" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Neko Game Launcher" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Your PC library, launchers, free games and deals in one place" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                     ToolTip="Search your installed library" />
        </Grid>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Library">
                <DockPanel Margin="0,14,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Rescan Library" Command="{Binding RefreshLibraryCommand}" />
                        <TextBlock Text="{Binding Games.Count, StringFormat={}{0} games}" Margin="12,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding GamesView}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14" Margin="6" Width="285" Height="150">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Launcher}" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding InstallPath}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Row="1" Content="Play" Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="Deals &amp; Free Games">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <TextBox Width="360" Text="{Binding DealsQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search offers or look up a game" />
                        <Button Content="Refresh Offers" Command="{Binding RefreshDealsCommand}" />
                        <Button Content="Look Up Game" Command="{Binding LookupGamesCommand}" />
                        <CheckBox Content="Free only" IsChecked="{Binding FreeOnly}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <GroupBox Header="Offers" Foreground="{StaticResource TextBrush}" Margin="0,0,8,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Deals}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12" Margin="5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Width="78" Height="60" Background="#252936" CornerRadius="5">
                                                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Source}" Foreground="{StaticResource MutedTextBrush}" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding PriceLabel}" FontWeight="Bold" />
                                                            <TextBlock Text="{Binding NormalPrice}" Margin="8,0,0,0" Foreground="{StaticResource MutedTextBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="View" Command="{Binding DataContext.OpenDealCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Game lookup" Foreground="{StaticResource TextBrush}" Margin="8,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding OnlineGames}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="10" Margin="5">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding CheapestPrice}" Foreground="{StaticResource MutedTextBrush}" />
                                                    <Button Content="Open Cheapest Deal" Command="{Binding DataContext.OpenLookupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Launchers">
                <ScrollViewer Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Launchers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="14" Margin="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="130"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" />
                                        <TextBlock Grid.Column="2" Text="{Binding GameCount, StringFormat={}{0} games}" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding ExecutablePath}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Built-in deal providers" FontSize="18" FontWeight="SemiBold" />
                        <CheckBox Content="GamerPower free games/giveaways" IsChecked="{Binding UseGamerPower}" />
                        <CheckBox Content="CheapShark PC game deals and lookup" IsChecked="{Binding UseCheapShark}" />
                        <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" />

                        <Separator Margin="0,18" />
                        <TextBlock Text="Custom deals endpoint" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Accepts a JSON array, or an object containing deals/offers/games/data/results. See docs/deals-endpoint.md." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <WrapPanel>
                            <TextBox Width="190" Text="{Binding NewEndpointName}" ToolTip="Endpoint name" Margin="4" />
                            <TextBox Width="500" Text="{Binding NewEndpointUrl}" ToolTip="https://example.com/api/deals" Margin="4" />
                            <Button Content="Add Endpoint" Command="{Binding AddEndpointCommand}" />
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding CustomEndpoints}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="10" Margin="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding Url}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}" />
                                            <Button Grid.Column="2" Content="Remove" Command="{Binding DataContext.RemoveEndpointCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock Grid.Column="1" Text="Free-game data: GamerPower • Deal data: CheapShark" Foreground="{StaticResource MutedTextBrush}" />
        </Grid>
    </Grid>
</Window>
