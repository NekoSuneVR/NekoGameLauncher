<Window x:Class="NekoGameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neko Game Launcher"
        Height="850" Width="1400" MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom dark title bar so Windows accent colours cannot turn the app bright/green. -->
            <Border Grid.Row="0" Background="#090D15" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="23" Height="23" CornerRadius="7" Background="{StaticResource AccentGradientBrush}" Margin="0,0,9,0">
                            <TextBlock Text="N" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Neko Game Launcher" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Background="#132033" CornerRadius="5" Padding="7,2" Margin="10,0,0,0">
                            <TextBlock Text="BETA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowButtonStyle}" Content="—" Click="Minimize_Click" ToolTip="Minimize" />
                        <Button Style="{StaticResource WindowButtonStyle}" Content="□" Click="Maximize_Click" ToolTip="Maximize / Restore" />
                        <Button Style="{StaticResource WindowButtonStyle}" Content="✕" Click="Close_Click" ToolTip="Close" />
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="1">
                <TabItem Header="LIBRARY" Style="{StaticResource NavTabStyle}">
                    <Grid Margin="30,26,30,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="380" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Your Library" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="Everything installed across your PC, in one launcher." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="SEARCH INSTALLED GAMES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource DimTextBrush}" Margin="2,0,0,6" />
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search your installed library" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource HeroGradientBrush}" BorderBrush="#41305F" BorderThickness="1" CornerRadius="16" Margin="0,22,0,18" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="READY TO PLAY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Games.Count}" FontSize="34" FontWeight="Bold" />
                                        <TextBlock Text=" games discovered" FontSize="16" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Bottom" Margin="4,0,0,6" />
                                    </StackPanel>
                                    <TextBlock Text="Steam, Epic, EA, Ubisoft, Rockstar, Xbox and more are scanned locally." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="↻  Rescan Library" Command="{Binding RefreshLibraryCommand}" VerticalAlignment="Center" Padding="20,11" />
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding GamesView}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorderStyle}" Width="310" Height="170" Margin="0,0,14,14">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="36" Height="36" CornerRadius="10" Background="#221D3B" BorderBrush="#4D3B7A" BorderThickness="1">
                                                        <TextBlock Text="◆" Foreground="{StaticResource AccentBrightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                                        <TextBlock Text="{Binding Launcher}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" />
                                                        <TextBlock Text="INSTALLED" FontSize="9" Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Grid.Row="1" Margin="0,12,0,8">
                                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="48" />
                                                    <TextBlock Text="{Binding InstallPath}" Foreground="{StaticResource DimTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                                                </StackPanel>
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="LOCAL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource DimTextBrush}" VerticalAlignment="Center" />
                                                    <Button Grid.Column="1" Content="▶  PLAY" Padding="16,7"
                                                            Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource DimTextBrush}" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="LOCAL LIBRARY • NO LAUNCHER PASSWORDS READ" Foreground="{StaticResource DimTextBrush}" FontSize="10" FontWeight="SemiBold" />
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="DEALS &amp; FREE GAMES" Style="{StaticResource NavTabStyle}">
                    <Grid Margin="30,26,30,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Deals &amp; Free Games" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="Find giveaways and discounted PC games without leaving your launcher." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#102622" BorderBrush="#1F5C4C" BorderThickness="1" CornerRadius="10" Padding="12,7" VerticalAlignment="Center">
                                <TextBlock Text="● LIVE DEAL FEEDS" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="Bold" />
                            </Border>
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="13" Padding="12" Margin="0,20,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding DealsQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search offers or look up a game" Margin="0,0,8,0" />
                                <Button Grid.Column="1" Content="Refresh Offers" Command="{Binding RefreshDealsCommand}" />
                                <Button Grid.Column="2" Content="Look Up Game" Command="{Binding LookupGamesCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                <CheckBox Grid.Column="3" Content="Free only" IsChecked="{Binding FreeOnly}" VerticalAlignment="Center" Margin="14,0,8,0" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBlock Text="FEATURED OFFERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" Margin="7,3,0,10" />
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Deals}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0E1623" BorderBrush="#26344C" BorderThickness="1" CornerRadius="11" Padding="12" Margin="4,4,4,9">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="102"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <Border Width="90" Height="68" Background="#090E16" CornerRadius="8" BorderBrush="#29364B" BorderThickness="1">
                                                                <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="12,0">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Source}" Foreground="{StaticResource CyanBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,3,0,0" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                    <TextBlock Text="{Binding PriceLabel}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                                                                    <TextBlock Text="{Binding NormalPrice}" Margin="9,0,0,0" Foreground="{StaticResource DimTextBrush}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Content="VIEW" Padding="14,7"
                                                                    Command="{Binding DataContext.OpenDealCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBlock Text="GAME LOOKUP" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrightBrush}" Margin="7,3,0,10" />
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding OnlineGames}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0E1623" BorderBrush="#26344C" BorderThickness="1" CornerRadius="10" Padding="12" Margin="4,4,4,9">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding CheapestPrice, StringFormat=Best known price: {0}}" Foreground="{StaticResource SuccessBrush}" Margin="0,5,0,8" />
                                                            <Button Content="OPEN CHEAPEST DEAL" Padding="12,7" HorizontalAlignment="Left"
                                                                    Command="{Binding DataContext.OpenLookupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="3" Text="Free-game data: GamerPower • Deal data: CheapShark" Foreground="{StaticResource DimTextBrush}" FontSize="10" Margin="0,12,0,0" HorizontalAlignment="Right" />
                    </Grid>
                </TabItem>

                <TabItem Header="LAUNCHERS" Style="{StaticResource NavTabStyle}">
                    <Grid Margin="30,26,30,20">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Connected Launchers" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="Neko automatically detects installed launchers and imports the games it can verify." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Border Grid.Row="1" Background="#17152B" BorderBrush="#403761" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,20,0,14">
                            <TextBlock Text="TIP  •  A detected launcher and detected games are separate checks. The Epic scanner now reads both Epic manifests and LauncherInstalled.dat, with .egstore fallback discovery." Foreground="#C7BDF6" TextWrapping="Wrap" />
                        </Border>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Launchers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorderStyle}" Padding="17" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="230" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="38" Height="38" CornerRadius="11" Background="#211D37" BorderBrush="#463A69" BorderThickness="1" VerticalAlignment="Center">
                                                    <TextBlock Text="◆" Foreground="{StaticResource AccentBrightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="9" Height="9" CornerRadius="5" Margin="0,0,8,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <TextBlock Text="{Binding StatusLabel}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding GameCount, StringFormat={}{0} games}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding ExecutablePath}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource DimTextBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="SETTINGS" Style="{StaticResource NavTabStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="30,26,30,30" MaxWidth="980" HorizontalAlignment="Left">
                            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="Tune deal providers and add your own Neko-compatible endpoint." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,22" />

                            <Border Style="{StaticResource CardBorderStyle}" Padding="20" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="DEAL PROVIDERS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" />
                                    <TextBlock Text="Built-in sources" Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,10" />
                                    <CheckBox Content="GamerPower free games and giveaways" IsChecked="{Binding UseGamerPower}" />
                                    <CheckBox Content="CheapShark PC game deals and price lookup" IsChecked="{Binding UseCheapShark}" />
                                    <Button Content="SAVE SETTINGS" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="CUSTOM INTEGRATION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrightBrush}" />
                                    <TextBlock Text="Custom deals endpoint" Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,5" />
                                    <TextBlock Text="Accepts a JSON array, or an object containing deals/offers/games/data/results. See docs/deals-endpoint.md." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewEndpointName}" ToolTip="Endpoint name" Margin="0,0,8,0" />
                                        <TextBox Grid.Column="1" Text="{Binding NewEndpointUrl}" ToolTip="https://example.com/api/deals" Margin="0,0,8,0" />
                                        <Button Grid.Column="2" Content="ADD ENDPOINT" Command="{Binding AddEndpointCommand}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding CustomEndpoints}" Margin="0,14,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0E1623" BorderBrush="#26344C" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Url}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                                        <Button Grid.Column="2" Content="REMOVE" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6"
                                                                Command="{Binding DataContext.RemoveEndpointCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
